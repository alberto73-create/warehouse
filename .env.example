# Adapter predefinito per sviluppo e test; usare "google" soltanto in staging/produzione.
DATA_ADAPTER=mock

# Credenziali server-only del Service Account Google. Sono supportati sia newline
# reali sia sequenze letterali "\\n" nella chiave privata.
GOOGLE_CLIENT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_SHEET_ID=

# Credenziali server-only Manager. Usare valori lunghi e casuali in Vercel.
MANAGER_PIN=
MANAGER_TOKEN_SECRET=
